{
  "name": "editor-video",
  "productName": "EditorVideo",
  "version": "1.0.0",
  "description": "Editor de vídeo local com legenda automática, corte automático e camadas",
  "author": "Thadeu",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
